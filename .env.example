# Session signing key - must be at least 32 characters. Generate with:
#   openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-me-to-at-least-32-random-characters

# Local: a SQLite file. Production: a libSQL/Turso URL.
DATABASE_URL=file:./.data/board.db
# DATABASE_AUTH_TOKEN=   # only for a remote libSQL/Turso database

# Optional
GOOGLE_MAPS_API_KEY=
